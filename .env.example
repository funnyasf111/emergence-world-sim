# LLM (required for --llm / scheduler --llm)
OPENAI_API_KEY=sk-...
# Optional: OpenAI-compatible endpoint (local LM Studio, vLLM, etc.)
# EMERGENCE_LLM_BASE_URL=http://localhost:1234/v1
# EMERGENCE_LLM_MODEL=gpt-4o-mini

# Per-agent models (optional)
# EMERGENCE_MODEL_ANCHOR=claude-sonnet-4-20250514
# EMERGENCE_MODEL_MIRA=gpt-4o-mini

# PostgreSQL (optional; default is SQLite emergence_world.db)
# DATABASE_URL=postgresql://emergence:emergence@localhost:5432/emergence_world

# LLM pacing
# EMERGENCE_LLM_DELAY=0.5
